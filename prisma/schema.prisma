datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model User {
  id            String      @id @default(cuid())
  name          String?
  email         String      @unique
  emailVerified DateTime?
  image         String?
  password      String?
  accounts      Account[]
  Chat          Chat[]
  aiKeys        AiKey[]
  aiSettings    AiSettings?
  aiUsage       AiUsage[]
}

model Chat {
  id             String      @id @default(cuid())
  name           String
  pdfLink        String
  pdfStoragePath String
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  messages       Message[]
  user           User        @relation(fields: [userId], references: [id])
  userId         String
  summary        Summary?
  flashcards     Flashcard[]
  note           String?
  chunks         Chunk[]

  // which model built this document's vectors: questions must be embedded with the same one
  embedProvider AiProvider?
  embedModel    String?
  // whose key processed it (the shared allowance counts PLATFORM documents)
  aiSource      AiSource?
  // last key related failure, so the UI can offer "Add your key": NO_KEY, INVALID_KEY, QUOTA, PLATFORM_LIMIT, BAD_MODEL
  errorCode     String?
  quiz          QuizQuestion[]

  // background pipeline state (see src/inngest)
  status           JobStatus @default(PENDING)
  summaryStatus    JobStatus @default(IDLE)
  flashcardsStatus JobStatus @default(IDLE)
  quizStatus       JobStatus @default(IDLE)
  processingError  String?

  @@unique([userId, name])
}

// the parsed PDF text, stored once and reused by indexing, summary and flashcards
model Chunk {
  id        String                       @id @default(cuid())
  chatId    String
  chat      Chat                         @relation(fields: [chatId], references: [id], onDelete: Cascade)
  index     Int
  page      Int?
  content   String                       @db.Text
  // pgvector, filled by the indexing step. Written/read with raw SQL (src/lib/ai)
  embedding Unsupported("vector(1536)")?

  @@unique([chatId, index])
}

enum JobStatus {
  IDLE
  PENDING
  PROCESSING
  READY
  FAILED
}

model Flashcard {
  id       String @id @unique @default(cuid())
  question String
  answer   String
  chatId   String
  chat     Chat   @relation(fields: [chatId], references: [id], onDelete: Cascade)
}

model Message {
  id        String   @id @unique @default(cuid())
  createdAt DateTime @default(now())
  content   String
  role      Role     @default(user)
  // pages the answer was based on: [{ page, snippet }]
  sources   Json?
  chat      Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
  chatId    String

  @@index([chatId, createdAt])
}

model QuizQuestion {
  id          String   @id @default(cuid())
  chatId      String
  chat        Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
  index       Int
  question    String
  options     String[]
  answerIndex Int
  explanation String

  @@unique([chatId, index])
}

model Summary {
  id            String   @id @unique @default(cuid())
  introduction  String
  abstract      String
  keyTakeaways  String[]
  tldr          String
  mostUsedWords Word[]
  // one to one relation with chat  
  chat          Chat?    @relation(fields: [chatId], references: [id], onDelete: Cascade)
  chatId        String   @unique
}

model Word {
  id        String  @id @unique @default(cuid())
  text      String
  value     Int
  summary   Summary @relation(fields: [summaryId], references: [id], onDelete: Cascade)
  summaryId String
}

enum Role {
  user
  assistant
  system
  tool
  function
  data
}

enum AiProvider {
  OPENAI
  GOOGLE
}

enum AiSource {
  USER
  PLATFORM
}

// A user's own provider key. Only the AES-256-GCM ciphertext is stored (bound to the user), never the key.
model AiKey {
  id          String     @id @default(cuid())
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider    AiProvider
  cipher      String
  last4       String
  keyVersion  Int        @default(1)
  validatedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@unique([userId, provider])
}

// Which provider and model a user chats and embeds with. The keys live in AiKey.
model AiSettings {
  id            String     @id @default(cuid())
  userId        String     @unique
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  chatProvider  AiProvider @default(OPENAI)
  chatModel     String
  embedProvider AiProvider @default(OPENAI)
  embedModel    String
  updatedAt     DateTime   @updatedAt
}

// Per day usage of the shared (platform) key, for its free allowance.
model AiUsage {
  userId  String
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  day     DateTime @db.Date
  actions Int      @default(0) // chat messages and regenerations

  @@id([userId, day])
}
