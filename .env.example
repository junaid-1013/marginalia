# Postgres (Neon via Vercel Marketplace). DATABASE_URL = pooled, DIRECT_URL = non-pooled (used by prisma migrate)
DATABASE_URL=
DIRECT_URL=

# Auth.js secret: `npx auth secret`
AUTH_SECRET=

# Vercel Blob (Vercel dashboard > Storage > Blob > .env.local tab)
BLOB_READ_WRITE_TOKEN=

# OpenAI
OPENAI_API_KEY=

# Qdrant (removed in phase 4 when we move to pgvector)
QDRANT_API_KEY=
QDRANT_HOST=
