# Postgres with pgvector (Neon via Vercel Marketplace has it built in; locally: `docker compose up -d`, port 5433). DATABASE_URL = pooled, DIRECT_URL = non-pooled (used by prisma migrate)
DATABASE_URL=
DIRECT_URL=

# Auth.js secret: `npx auth secret`
AUTH_SECRET=

# Optional Google sign in (Google Cloud Console > OAuth client, redirect URI: <app url>/api/auth/callback/google)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Vercel Blob (Vercel dashboard > Storage > Blob > .env.local tab)
BLOB_READ_WRITE_TOKEN=
# must match the store type you created in Vercel: private (default) or public
NEXT_PUBLIC_BLOB_ACCESS=private

# OpenAI (or any OpenAI compatible server, e.g. OPENAI_BASE_URL=http://localhost:11434/v1 for Ollama)
OPENAI_API_KEY=
OPENAI_BASE_URL=
# optional. Chat default: gpt-4o-mini. Embedding default: text-embedding-3-small
# (the embedding model must output 1536 dimensions, matching Chunk.embedding)
AI_CHAT_MODEL=
AI_EMBED_MODEL=

# Google Gemini shared key (optional). Users can pick OpenAI or Gemini in AI settings.
GOOGLE_GENERATIVE_AI_API_KEY=
GOOGLE_BASE_URL=

# Bring your own key. Users save their own OpenAI/Gemini key in AI settings.
# Keys are encrypted with AES-256-GCM using this secret (32 bytes, base64): `openssl rand -base64 32`
# Required for saving keys. Losing it makes saved keys unreadable. Never commit it.
KEY_ENCRYPTION_SECRET=
# Rotation: bump the version, put the old secret in KEY_ENCRYPTION_SECRET_V<old>. Default 1
KEY_ENCRYPTION_VERSION=1

# Shared key limits (the OPENAI_API_KEY / GOOGLE_GENERATIVE_AI_API_KEY above).
# 0 or empty = unlimited, which is right for self hosting. On a public deploy set both so
# users are asked to add their own key once the allowance is used.
# Set ALLOW_PLATFORM_KEY=false to require every user to bring a key.
ALLOW_PLATFORM_KEY=
PLATFORM_FREE_DOCUMENTS=
PLATFORM_FREE_ACTIONS_PER_DAY=

# Inngest (background jobs). Not needed locally: run `bun run dev:inngest` next to `bun dev`.
# In production add the Inngest integration from the Vercel Marketplace, it sets both keys.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# optional: documents one account may keep (default 10)
MAX_DOCUMENTS_PER_USER=

# optional: canonical site url for metadata and the sitemap (falls back to the Vercel production url)
NEXT_PUBLIC_SITE_URL=
